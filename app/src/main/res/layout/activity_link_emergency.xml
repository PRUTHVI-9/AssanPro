<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="com.example.AsaanPro_V1.MainActivity">

    <ProgressBar
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progressBarLinkEmergency"
        android:visibility="invisible"
        android:indeterminate="true"
        android:layout_centerInParent="true" />

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linearLayoutSearch">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Mobile Number"
                android:id="@+id/textView12"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewMobileNumber"
                android:layout_toRightOf="@+id/editTextPatientID"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Date Of Birth"
                android:id="@+id/textView13"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewDOB"
                android:layout_toRightOf="@+id/editTextMobileNumber"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="First Name"
                android:id="@+id/textView14"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewFirstName"
                android:layout_toRightOf="@+id/editTextDOB"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Middle Name"
                android:id="@+id/textView15"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewMiddleName"
                android:layout_toRightOf="@+id/editTextFirstName"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Last Name"
                android:id="@+id/textView17"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewLastName"
                android:layout_toRightOf="@+id/editTextMiddleName"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imageViewCommStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.5"
            android:src="@android:drawable/presence_online" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Emergency Log : "
        android:id="@+id/textViewEmergencyLog"
        android:layout_below="@+id/linearLayoutSearch"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/TAB_G_TextSizeLarge"
        android:textStyle="bold"
        android:layout_marginTop="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="0"
        android:id="@+id/textViewEmergencyCount"
        android:layout_toRightOf="@+id/textViewEmergencyLog"
        android:layout_alignBottom="@+id/textViewEmergencyLog"
        android:textSize="@dimen/TAB_G_TextSizeLarge"
        android:textStyle="bold"
        android:textColor="@color/cyan" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/scrollView"
        android:layout_below="@+id/textViewEmergencyLog"
        android:layout_above="@+id/linearLayoutControl">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:showDividers="beginning|middle|end"
            android:layout_above="@+id/linearLayoutControl"
            android:layout_below="@+id/textViewEventLog"
            android:id="@+id/tableLayoutEmergencyLog"
            android:divider="@color/black"
            android:layout_margin="2dp"
            android:background="@color/black"
            android:stretchColumns="*">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_margin="2dip"
                android:background="@color/black"
                android:showDividers="beginning|middle|end"
                android:id="@+id/trEmergencyLogHeader">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Date"
                    android:id="@+id/textView3"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="@dimen/TAB_G_TextSizeLarge" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Time"
                    android:id="@+id/textView9"
                    android:layout_weight="1"
                    android:singleLine="false"
                    android:textSize="@dimen/TAB_G_TextSizeLarge"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Emergency"
                    android:id="@+id/textView5"
                    android:layout_weight="3"
                    android:textStyle="bold"
                    android:textSize="@dimen/TAB_G_TextSizeLarge" />

            </TableRow>

        </TableLayout>
    </ScrollView>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:id="@+id/linearLayoutControl">

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:id="@+id/buttonBackLinkEmergency"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:onClick="onClickLinkEmergency"
            android:textSize="@dimen/TAB_G_TextSizeMedium"
            android:textStyle="bold"
            android:layout_alignBottom="@+id/editTextPatientID"
            android:layout_weight="1" />

        <Button
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Link"
            android:id="@+id/buttonLink"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:onClick="onClickLinkEmergency"
            android:layout_weight="1"
            android:textSize="@dimen/TAB_G_TextSizeMedium"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
