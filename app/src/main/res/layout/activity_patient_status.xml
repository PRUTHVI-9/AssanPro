<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="com.example.AsaanPro_V1.MainActivity">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linearLayoutSearch">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Mobile Number"
                android:id="@+id/textView6"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewMobileNumber"
                android:layout_toRightOf="@+id/editTextPatientID"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Date Of Birth"
                android:id="@+id/textView7"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewDOB"
                android:layout_toRightOf="@+id/editTextMobileNumber"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="First Name"
                android:id="@+id/textView18"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewFirstName"
                android:layout_toRightOf="@+id/editTextDOB"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Middle Name"
                android:id="@+id/textView19"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewMiddleName"
                android:layout_toRightOf="@+id/editTextFirstName"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Last Name"
                android:id="@+id/textView8"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewLastName"
                android:layout_toRightOf="@+id/editTextMiddleName"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imageViewCommStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.5"
            android:src="@android:drawable/presence_online" />

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="false"
        android:id="@+id/linearLayoutControl"
        android:layout_below="@+id/linearLayoutSearch"
        android:layout_marginTop="20dp">

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Close"
            android:id="@+id/buttonCancel"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:onClick="onClickPatientStatus"
            android:textSize="@dimen/TAB_G_TextSizeSmall"
            android:textStyle="bold"
            android:layout_alignBottom="@+id/editTextPatientID"
            android:layout_weight="1.1" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Patient Details"
            android:id="@+id/buttonEditDetails"
            android:layout_alignParentTop="true"
            android:textSize="@dimen/TAB_G_TextSizeSmall"
            android:textStyle="bold"
            android:layout_toLeftOf="@+id/buttonClose"
            android:layout_alignBottom="@+id/editTextPatientID"
            android:layout_weight="1"
            android:onClick="onClickPatientStatus" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Medical History"
            android:id="@+id/buttonEditHistory"
            android:layout_alignParentTop="true"
            android:textSize="@dimen/TAB_G_TextSizeSmall"
            android:textStyle="bold"
            android:layout_toLeftOf="@+id/buttonEditDetails"
            android:layout_alignBottom="@+id/editTextPatientID"
            android:layout_weight="1"
            android:onClick="onClickPatientStatus" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Link Emergency"
            android:id="@+id/buttonLinkEmergency"
            android:textStyle="bold"
            android:textSize="@dimen/TAB_G_TextSizeSmall"
            android:layout_weight="1"
            android:onClick="onClickPatientStatus" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="New ECG"
            android:id="@+id/buttonNewECG"
            android:layout_weight="1.1"
            android:textSize="@dimen/TAB_G_TextSizeSmall"
            android:textStyle="bold"
            android:onClick="onClickPatientStatus" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Event Log"
        android:id="@+id/textViewEventLog"
        android:layout_below="@+id/linearLayoutControl"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/TAB_G_TextSizeLarge"
        android:visibility="visible"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="0"
        android:id="@+id/textViewLogCount"
        android:layout_toRightOf="@+id/textViewEventLog"
        android:layout_alignBottom="@+id/textViewEventLog"
        android:textSize="@dimen/TAB_G_TextSizeLarge"
        android:textStyle="bold"
        android:visibility="invisible"
        android:textColor="@color/cyan" />

    <ProgressBar
        android:id="@+id/progressBarPatientStatus"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/linearLayoutControl"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_toLeftOf="@id/textViewEventLog"
        android:indeterminate="true"
        android:visibility="invisible" />
<!--    android:layout_centerInParent="true"-->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/scrollView2"
        android:layout_below="@+id/textViewEventLog"
        android:layout_alignParentBottom="true">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:showDividers="beginning|middle|end"
            android:layout_above="@+id/linearLayoutControl"
            android:layout_below="@+id/textViewEventLog"
            android:id="@+id/tableLayoutEventLog"
            android:divider="@color/black"
            android:layout_margin="2dp"
            android:background="@color/black"
            android:stretchColumns="*">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_margin="2dip"
                android:background="@color/black"
                android:showDividers="beginning|middle|end"
                android:id="@+id/trEventLogHeader">

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Date"
                    android:id="@+id/textView3"
                    android:layout_weight="1"
                    android:textStyle="bold"
                    android:textSize="@dimen/TAB_G_TextSizeLarge" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Time"
                    android:id="@+id/textView9"
                    android:layout_weight="1"
                    android:singleLine="false"
                    android:textStyle="bold"
                    android:textSize="@dimen/TAB_G_TextSizeLarge" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Event"
                    android:id="@+id/textView5"
                    android:layout_weight="3"
                    android:textStyle="bold"
                    android:textSize="@dimen/TAB_G_TextSizeLarge" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textView35"
                    android:textSize="@dimen/TAB_G_TextSizeLarge"
                    android:layout_weight="1"
                    android:visibility="invisible"
                    android:text="Event Action"
                    android:textStyle="bold" />

            </TableRow>

        </TableLayout>
    </ScrollView>

</RelativeLayout>
