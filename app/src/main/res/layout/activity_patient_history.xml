                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:digits="@string/alpha_numeric_hiphen_keys"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="text"
                        android:maxLength="256"
                        android:singleLine="true"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textViewHistoryConditions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minEms="8"
                        android:text="History Conditions : "
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <!--<MultiAutoCompleteTextView-->
                        <!--android:id="@+id/multiAutoCompleteTextView"-->
                        <!--android:layout_width="fill_parent"-->
                        <!--android:layout_height="wrap_content"-->
                        <!--android:layout_weight="1"-->
                        <!--android:digits="@string/history_condition_keys"-->
                        <!--android:enabled="false"-->
                        <!--android:imeOptions="actionDone"-->
                        <!--android:inputType="text"-->
                        <!--android:textSize="@dimen/TAB_G_TextSizeMedium" />-->
                </LinearLayout>

