                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition44"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Drinking"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition16"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
