                                android:text="Abdominal Pain"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition42"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Allergy"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Angina(chest Pain)"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Angioplasty"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition5"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Anxiety"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition6"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Aorta disease"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="10dp"
                            android:orientation="vertical">

                            <CheckBox
                                android:id="@+id/checkBoxCondition7"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Arrythmia"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition8"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Atrial Fibrillation"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition9"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Blood test - CPK"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition10"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Bypass"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition11"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="Cardiomyopathy"
                                android:textAppearance="@android:style/TextAppearance.Medium"
