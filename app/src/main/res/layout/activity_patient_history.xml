<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patientHistoryLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="beforeDescendants"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true" >

    <LinearLayout
        android:id="@+id/linearLayoutMedical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/LinearLayoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >
            <!--android:layout_alignParentTop="true" >-->

            <TextView
                android:id="@+id/textViewHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Patient History"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:textSize="@dimen/TAB_G_TextSizeLarge" />

            <Button
                android:id="@+id/buttonSaveMedical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="false"
                android:layout_toLeftOf="@+id/imageViewCommStatus"
                android:onClick="onClickPatientHistory"
                android:text="SAVE"
                android:textSize="@dimen/TAB_G_TextSizeLarge"
                android:textStyle="bold" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BACK"
                android:id="@+id/buttonBackMedical"
                android:textStyle="bold"
                android:textSize="@dimen/TAB_G_TextSizeLarge"
                android:onClick="onClickPatientHistory" />

            <ImageView
                android:id="@+id/imageViewCommStatus"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignBottom="@+id/buttonBackMedical"
                android:layout_alignParentRight="true"
                android:layout_alignParentTop="false"
                android:layout_alignTop="@+id/buttonBackMedical"
                android:src="@android:drawable/presence_online" />

        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/scrollViewMedical" >

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView24"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Height (cm):"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextHeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:digits="@string/numeric_keys"
                        android:ems="10"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="number|numberDecimal"
                        android:maxLength="5"
                        android:numeric="decimal"
                        android:singleLine="true"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <TextView
                        android:id="@+id/textView25"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Weight (Kg):"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextWeight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ems="10"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        android:numeric="decimal"
                        android:singleLine="true"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <TextView
                        android:id="@+id/textView43"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="BMI:"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <TextView
                        android:id="@+id/textViewBMI"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ems="10"
                        android:lines="1"
                        android:textStyle="bold"
                        android:maxLength="5"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <TextView
                        android:id="@+id/textViewSystolic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Systolic:"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextSystolic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:digits="@string/numeric_keys"
                        android:ems="10"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="number"
                        android:maxLength="3"
                        android:numeric="integer"
                        android:singleLine="true"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <TextView
                        android:id="@+id/textViewDiastolic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="Diastolic:"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextDiastolic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:digits="@string/numeric_keys"
                        android:ems="10"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:inputType="number"
                        android:maxLength="3"
                        android:numeric="integer"
                        android:singleLine="true"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <CheckBox
                        android:id="@+id/checkBoxTropT"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:textSize="@dimen/TAB_G_TextSizeMedium"
                        android:text="TropT" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView51"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hb:"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextHb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:ems="10"
                        android:inputType="numberDecimal" />

                    <TextView
                        android:id="@+id/textView45"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HbA1c:"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextHbA1c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:ems="10"
                        android:inputType="numberDecimal" />

                    <TextView
                        android:id="@+id/textView46"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="RBS:"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextRBS"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:ems="10"
                        android:inputType="number" />

                    <TextView
                        android:id="@+id/textView47"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="TC:"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextTC"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:ems="10"
                        android:inputType="number" />

                    <TextView
                        android:id="@+id/textView48"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="LDL:"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextLDL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:ems="10"
                        android:inputType="number" />

                    <TextView
                        android:id="@+id/textView50"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="HDL:"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextHDL"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:ems="10"
                        android:inputType="number" />

                    <TextView
                        android:id="@+id/textView49"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="10dp"
                        android:text="TG:"
                        android:textSize="@dimen/TAB_G_TextSizeMedium" />

                    <EditText
                        android:id="@+id/editTextTG"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:ems="10"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
