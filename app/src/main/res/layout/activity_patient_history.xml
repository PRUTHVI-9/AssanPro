                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition22"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
                                android:text="High Blood Pressure"
                                android:textAppearance="@android:style/TextAppearance.Medium"
                                android:textSize="@dimen/TAB_G_TextSizeMedium" />

                            <CheckBox
                                android:id="@+id/checkBoxCondition23"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:onClick="onClickPatientHistory"
