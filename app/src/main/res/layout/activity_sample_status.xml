<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="com.example.AsaanPro_V1.MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Log of latest "
        android:id="@+id/textViewSampleLog"
        android:textSize="@dimen/TAB_G_TextSizeLarge"
        android:textStyle="bold"
        android:layout_alignBottom="@+id/textViewSampleCount"
        android:layout_toLeftOf="@+id/textViewSampleCount" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="100"
        android:id="@+id/textViewSampleCount"
        android:textSize="@dimen/TAB_G_TextSizeLarge"
        android:textStyle="bold"
        android:textColor="@color/cyan"
        android:layout_centerHorizontal="true"
        android:layout_alignParentTop="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text=" ECGs"
        android:id="@+id/textView30"
        android:layout_toRightOf="@+id/textViewSampleCount"
        android:layout_alignBottom="@+id/textViewSampleCount"
        android:textSize="@dimen/TAB_G_TextSizeLarge"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageViewCommStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:src="@android:drawable/presence_online" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/scrollView"
        android:layout_below="@+id/textViewSampleLog"
        android:layout_above="@+id/linearLayoutControl">

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:showDividers="beginning|middle|end"
            android:layout_above="@+id/linearLayoutControl"
            android:layout_below="@+id/textViewEventLog"
            android:id="@+id/tableLayoutSampleLog"
            android:divider="@color/black"
            android:layout_margin="2dp"
            android:background="@color/black"
            android:stretchColumns="*">

            <TableRow
                android:id="@+id/trSampleLogHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_margin="2dip"
                android:background="@color/black"
                android:showDividers="beginning|middle|end">

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Date"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/TAB_G_TextSizeLarge"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="false"
                    android:text="Time"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/TAB_G_TextSizeLarge"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView5"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:text="Firstname"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/TAB_G_TextSizeLarge"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:text="Status"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/TAB_G_TextSizeLarge"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textView38"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sent to Printer"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/TAB_G_TextSizeLarge"
                    android:textStyle="bold" />

            </TableRow>

        </TableLayout>
    </ScrollView>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:id="@+id/linearLayoutControl">

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:id="@+id/buttonBackSampleStatus"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:onClick="onClickSampleStatus"
            android:textSize="@dimen/TAB_G_TextSizeMedium"
            android:textStyle="bold"
            android:layout_alignBottom="@+id/editTextPatientID"
            android:layout_weight="1" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Refer Sample"
            android:id="@+id/buttonReferSample"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:onClick="onClickSampleStatus"
            android:textSize="@dimen/TAB_G_TextSizeMedium"
            android:textStyle="bold"
            android:layout_weight="1"
            android:enabled="false"
            android:visibility="invisible" />

        <Button
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="View Report"
            android:id="@+id/buttonViewSampleReport"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:onClick="onClickSampleStatus"
            android:layout_weight="1"
            android:textSize="@dimen/TAB_G_TextSizeMedium"
            android:textStyle="bold" />

    </LinearLayout>

</RelativeLayout>
