<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    tools:context="com.example.AsaanPro_V1.MainActivity">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/linearLayoutSearch">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Mobile Number"
                android:id="@+id/textView12"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewMobileNumber"
                android:layout_toRightOf="@+id/editTextPatientID"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Date Of Birth"
                android:id="@+id/textView13"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewDOB"
                android:layout_toRightOf="@+id/editTextMobileNumber"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="First Name"
                android:id="@+id/textView14"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewFirstName"
                android:layout_toRightOf="@+id/editTextDOB"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Middle Name"
                android:id="@+id/textView15"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewMiddleName"
                android:layout_toRightOf="@+id/editTextFirstName"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:text="Last Name"
                android:id="@+id/textView17"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

            <TextView
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?android:attr/textAppearanceMedium"
                android:id="@+id/textViewLastName"
                android:layout_toRightOf="@+id/editTextMiddleName"
                android:textSize="@dimen/TAB_G_TextSizeMedium" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imageViewCommStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="0.5"
            android:src="@android:drawable/presence_online" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Emergency"
        android:id="@+id/textViewEmergency"
        android:textSize="@dimen/TAB_G_TextSizeMedium"
        android:textColor="@color/red"
        android:layout_below="@+id/linearLayoutSearch"
        android:layout_alignParentRight="true"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:text="Event ID : "
        android:id="@+id/textViewEventLogID"
        android:layout_below="@+id/linearLayoutSearch"
        android:layout_centerHorizontal="true"
        android:textSize="@dimen/TAB_G_TextSizeMedium"
        android:visibility="invisible"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:id="@+id/textViewLogID"
        android:layout_toRightOf="@+id/textViewEventLogID"
        android:layout_alignBottom="@+id/textViewEventLogID"
        android:textSize="@dimen/TAB_G_TextSizeMedium"
        android:textStyle="bold"
        android:textColor="@color/cyan"
        android:visibility="invisible"
        android:text="-" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/scrollView"
        android:layout_below="@+id/textViewEventLogID"
        android:layout_above="@+id/linearLayoutControl">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Height(cm):"
                    android:id="@+id/textView24"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewHeight"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Weight(kg):"
                    android:id="@+id/textView25"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewWeight"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="BMI:"
                    android:id="@+id/textView34"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewBMI"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textView29"
                    android:text="BP:"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewBloodPressure"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_weight="1" />

                <CheckBox
                    android:id="@+id/checkBoxTropT"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:enabled="false"
                    android:text="TropT"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Hb:"
                    android:id="@+id/textView35"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewHb"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="HbA1c:"
                    android:id="@+id/textView36"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewHbA1c"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="RBS:"
                    android:id="@+id/textView37"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewRBS"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="TC:"
                    android:id="@+id/textView38"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewTC"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="LDL:"
                    android:id="@+id/textView39"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewLDL"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="HDL:"
                    android:id="@+id/textView40"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewHDL"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="TG:"
                    android:id="@+id/textView41"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_marginLeft="5dp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewTG"
                    android:layout_weight="1"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />

            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:text="History Condition : "
                    android:id="@+id/textView26"
                    android:textColor="@color/cyan" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewHistoryConditions"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="History Notes : "
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:id="@+id/textView27"
                    android:textColor="@color/cyan" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewHistoryNotes"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:text="Interpretation : "
                        android:id="@+id/textView28"
                        android:textSize="@dimen/TAB_G_TextSizeMedium"
                        android:textColor="@color/cyan"
                        android:layout_weight="0.9" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:text="ECG Time : "
                        android:id="@+id/textViewTime"
                        android:textSize="@dimen/TAB_G_TextSizeMedium"
                        android:textColor="@color/cyan"
                        android:visibility="invisible" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:id="@+id/textViewECGTime"
                        android:textSize="@dimen/TAB_G_TextSizeMedium"
                        android:layout_weight="1"
                        android:visibility="invisible" />

                </LinearLayout>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewInterpretation"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Comments : "
                    android:id="@+id/textView31"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:textColor="@color/cyan" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewComments"
                    android:textSize="@dimen/TAB_G_TextSizeMedium" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:text="Comments By : "
                    android:id="@+id/textView32"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:textColor="@color/cyan" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:id="@+id/textViewCommentsBy"
                    android:textSize="@dimen/TAB_G_TextSizeMedium"
                    android:layout_weight="1" />

                <!--<TextView-->
                    <!--android:layout_width="wrap_content"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:textAppearance="?android:attr/textAppearanceMedium"-->
                    <!--android:text="Comments Date : "-->
                    <!--android:id="@+id/textView33"-->
                    <!--android:textSize="@dimen/TAB_G_TextSizeMedium"-->
                    <!--android:textColor="@color/cyan" />-->

                <!--<TextView-->
                    <!--android:layout_width="fill_parent"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:textAppearance="?android:attr/textAppearanceMedium"-->
                    <!--android:id="@+id/textViewCommentsDate"-->
                    <!--android:textSize="@dimen/TAB_G_TextSizeMedium"-->
                    <!--android:layout_weight="1" />-->
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:id="@+id/linearLayoutControl">

        <Button
            android:id="@+id/buttonBackReports"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:onClick="onClickPatientReports"
            android:text="Back"
            android:textSize="@dimen/TAB_G_TextSizeMedium"
            android:textStyle="bold" />
        <!--android:layout_alignParentRight="false"-->
        <!--android:layout_alignParentTop="false"-->

<!--        <Button-->
<!--            android:layout_width="fill_parent"-->
<!--            android:layout_height="wrap_content"-->
<!--            android:text="Print - Thermal"-->
<!--            android:id="@+id/buttonPrintReportThermal"-->
<!--            android:textSize="@dimen/TAB_G_TextSizeMedium"-->
<!--            android:textStyle="bold"-->
<!--            android:layout_weight="1"-->
<!--            android:onClick="onClickPatientReports" />-->
<!--&lt;!&ndash;        android:text="Print Report - Thermal"&ndash;&gt;-->
<!--        &lt;!&ndash;android:layout_alignParentTop="true"&ndash;&gt;-->
<!--        &lt;!&ndash;android:layout_toLeftOf="@+id/buttonClose"&ndash;&gt;-->
<!--        &lt;!&ndash;android:layout_alignBottom="@+id/editTextPatientID"&ndash;&gt;-->

        <Button
            android:id="@+id/buttonPrintReportA4"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="onClickPatientReports"
            android:text="Print - A4"
            android:textSize="@dimen/TAB_G_TextSizeMedium"
            android:textStyle="bold" />
<!--        android:text="Print Report - A4"-->

        <Button
            android:id="@+id/buttonEmailReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:onClick="onClickPatientReports"
            android:text="Email"
            android:textSize="@dimen/TAB_G_TextSizeMedium"
            android:textStyle="bold" />
<!--        android:text="Email Report"-->

    </LinearLayout>

    <ProgressBar
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/progressBarReport"
        android:layout_centerInParent="true"
        android:visibility="invisible"
        android:indeterminateOnly="true" />

</RelativeLayout>
